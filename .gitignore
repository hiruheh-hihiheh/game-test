# Starfall Salvage. The Git repository root is this folder; the Godot project is in
# "Mobile game development capabilities/".

# --- Godot generated files -------------------------------------------------------------
# Import cache, shader cache and editor state. Godot rebuilds all of it when the project is opened,
# or with: godot --headless --path . --import
.godot/
# Keep .import and .uid files: they hold import settings and stable resource ids, so they are NOT ignored.

# --- Local backups and scratch work ----------------------------------------------------
# Earlier copies of the code, original high-resolution art, and one-off repair scripts.
# They stay on this PC only.
.work/

# --- Archives and exports --------------------------------------------------------------
# Downloaded art packs. Their contents are already in assets/ and in .work/art_originals_1254.
*.zip
# Build output (see export_presets.cfg: export paths are outputs/...)
outputs/
dist/
build/
*.apk
*.aab
*.idsig
*.exe
*.pck
# Android build template, regenerated by Project > Install Android Build Template
android/build/
android/.gradle/

# --- Secrets ---------------------------------------------------------------------------
# Never commit signing keys or credentials.
*.keystore
*.jks
export_credentials.cfg

# --- Temporary files and logs ----------------------------------------------------------
*.log
*.tmp
*.temp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Tooling ---------------------------------------------------------------------------
node_modules/
__pycache__/
*.pyc
