extends SceneTree

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var title_scene: PackedScene = load("res://scenes/title_screen.tscn")
	assert(title_scene != null)
	var title = title_scene.instantiate()
	root.add_child(title)
	await process_frame
	assert(title.has_method("_start_game"))
	title.queue_free()
	await process_frame
	var game_scene: PackedScene = load("res://scenes/game.tscn")
	assert(game_scene != null)
	var game = game_scene.instantiate()
	root.add_child(game)
	await process_frame
	assert(game.player_hp == 5)
	assert(game.phase == 0)
	assert(game.SEGMENT_DURATIONS == [24.0, 26.0, 28.0])
	assert(game.WAVES_PER_SEGMENT == 5)
	assert(absf(game.player_sprite.scale.x - 0.215) < 0.001)
	assert(game.far_sprites.size() == 2)
	assert(game.mid_sprites.size() == 2)
	assert(game.near_sprites.size() == 2)
	assert(game.bgm_player.stream != null)
	assert(game.bgm_player.stream.loop)
	assert(game.bgm_player.playing)
	assert(game.shoot_sfx.stream != null)
	assert(game.hit_sfx.stream != null)
	assert(game.explosion_sfx.stream != null)
	var tuning := root.get_node("TuningStore")
	tuning.reset_all()
	tuning.begin_run()
	tuning.set_value("player_speed", 360.0)
	assert(game.tuning_player_speed == 360.0)
	tuning.set_value("bgm_volume_db", -7.0)
	assert(game.bgm_player.volume_db == -7.0)
	tuning.reset_all()
	assert(game.tuning_player_speed == 350.0)
	assert(game.tuning_bone_drop == 0.015)
	assert(game.tuning_boss_health == 1.75)
	assert(tuning.run_custom) # Reset cannot restore eligibility during the same run.
	assert(game.phase == 0)
	var mid_x_before: float = game.mid_sprites[0].position.x
	game._update_ambient(1.0)
	assert(game.mid_sprites[0].position.x < mid_x_before)
	game.phase = 1
	game.fire_timer = 0.0
	game._update_player(0.016)
	assert(game.bullets.size() == 2)
	game.enemy_bullets.append({"pos": game.player_pos + Vector2(14, 0), "vel": Vector2.ZERO, "life": 1.0, "size": 7.0})
	game._check_enemy_bullets()
	assert(game.player_hp == 5)
	game.enemy_bullets[0].pos = game.player_pos + Vector2(4, 0)
	game._check_enemy_bullets()
	assert(game.player_hp == 4)
	game.invulnerable = 0.0
	tuning.set_value("enemy_health", 2.0)
	game.spawn_enemy(0)
	assert(game.enemies.size() == 1)
	assert(float(game.enemies[0].max_hp) == 6.0)
	tuning.set_value("enemy_health", 1.0)
	game._queue_formation(0)
	assert(game.enemies.size() == 13)
	var line_y: float = game.enemies[1].pos.y
	for i in range(1, 13):
		assert(absf(float(game.enemies[i].pos.y) - line_y) < 0.01)
	assert(float(game.enemies[12].fire) > float(game.enemies[1].fire))
	game._update_enemies(0.9)
	var swept_y: float = game.enemies[1].pos.y
	assert(absf(swept_y - line_y) > 150.0)
	for i in range(2, 13):
		assert(absf(float(game.enemies[i].pos.y) - swept_y) < 0.01)
	game._queue_formation(1)
	assert(game.current_formation == "V")
	game._queue_formation(2)
	assert(game.current_formation == "W")
	var enemies_before_count_test: int = game.enemies.size()
	tuning.set_value("enemy_count", 1.5)
	game._queue_formation(0)
	assert(game.enemies.size() == enemies_before_count_test + 18)
	tuning.set_value("enemy_count", 1.0)
	game.energy = 100.0
	game._activate_laser()
	assert(game.energy == 0.0)
	assert(game.laser_timer == 5.0)
	game.enemy_bullets.clear()
	game.enemy_bullets.append({"pos": game.player_pos + Vector2(300, 20), "vel": Vector2.ZERO, "life": 2.0, "size": 7.0})
	game.enemy_bullets.append({"pos": game.player_pos + Vector2(300, 180), "vel": Vector2.ZERO, "life": 2.0, "size": 7.0})
	game._update_abilities(0.016)
	assert(game.enemy_bullets.size() == 1)
	game.laser_timer = 0.0
	game.energy = 100.0
	game._activate_shield()
	assert(game.shield_hits == 3)
	assert(game.shield_timer == 60.0)
	var hp_before: int = game.player_hp
	game.invulnerable = 0.0
	game._damage_player()
	assert(game.player_hp == hp_before)
	assert(game.shield_hits == 2)
	game._spawn_bone(game.player_pos)
	game._update_pickups(0.016)
	assert(game.weapon_level == 1)
	assert(game.weapon_upgrade_timer > 0.0)
	assert(not game.weapon_upgrade_is_max)
	game.bullets.clear()
	game.shoot_player()
	assert(game.bullets.size() == 4)
	assert(not bool(game.bullets[0].maxed))
	game._spawn_bone(game.player_pos)
	game._update_pickups(0.016)
	assert(game.weapon_level == 2)
	game._spawn_bone(game.player_pos)
	game._update_pickups(0.016)
	assert(game.weapon_level == game.MAX_WEAPON_LEVEL)
	assert(game.weapon_upgrade_is_max)
	assert(game.weapon_upgrade_duration == 1.9)
	game.bullets.clear()
	game.shoot_player()
	assert(game.bullets.size() == 8)
	for max_bullet in game.bullets:
		assert(bool(max_bullet.maxed))
	var level_before_overflow: int = game.weapon_level
	game._spawn_bone(game.player_pos)
	game._update_pickups(0.016)
	assert(game.weapon_level == level_before_overflow)
	# Locale-independent: the first-launch language follows the machine/browser.
	assert(game.dialogue == root.get_node("I18n").t("dialogue.bone_energy"))
	game._spawn_bone(Vector2(700, 200))
	game._update_pickups(100.0)
	assert(game.pickups.size() == 1)
	game._start_boss(0)
	assert(game.phase == 2)
	assert(game.boss_tier == 0)
	assert(game.boss_sprite.texture == game.ELITE_BARRAGE)
	assert(game.boss_max_hp == 166.25)
	game._boss_volley()
	assert(game.enemy_bullets.size() == 3)
	game.boss_hp = 0.0
	game._boss_defeated()
	assert(game.phase == 1)
	assert(game.wave_segment == 1)
	assert(game.pickups.size() == 2)
	game._start_boss(1)
	assert(game.boss_sprite.texture == game.ELITE_LASER)
	game.boss_pos = Vector2(1060, 360)
	game.boss_special_timer = 0.0
	game._update_boss(0.016)
	assert(game.boss_laser_warning > 0.0)
	assert(game.boss_laser_end.y == game.player_pos.y)
	game.boss_laser_warning = 0.01
	game._update_boss_laser(0.02)
	assert(game.boss_laser_active > 0.0)
	game.boss_hp = 0.0
	game._boss_defeated()
	assert(game.phase == 1)
	assert(game.wave_segment == 2)
	game._start_boss(2)
	assert(game.boss_sprite.texture == game.ELITE_GEOMETRY)
	assert(game.boss_tier == 2)
	game.enemy_bullets.clear()
	game._boss_volley()
	assert(game.enemy_bullets.size() == 8)
	game.enemy_bullets.clear()
	game._boss_volley()
	assert(game.enemy_bullets.size() == 6)
	game.enemy_bullets.clear()
	game._boss_volley()
	assert(game.enemy_bullets.size() == 8)
	assert(absf(float(game.enemy_bullets[0].curve)) > 0.0)
	game.boss_hp = 0.0
	game._boss_defeated()
	assert(game.phase == 3)
	game.shield_timer = 0.01
	game.shield_hits = 3
	game.laser_timer = 0.01
	game._process(0.02)
	assert(game.shield_timer == 0.0)
	assert(game.shield_hits == 0)
	assert(game.laser_timer == 0.0)
	game._start_boss(3)
	assert(game.boss_tier == 3)
	assert(game.boss_sprite.texture == game.AI_BOSS)
	game.energy = 100.0
	game._activate_shield()
	assert(game.shield_timer == 60.0 and game.shield_hits == 3)
	game.enemy_bullets.clear()
	game._boss_volley()
	assert(game.enemy_bullets.size() == 10)
	game.boss_hp = 0.0
	game._boss_defeated()
	assert(game.phase == 4)
	print("[SMOKE_PASS] weapon_levels upgrade_feedback max_star_fang doubled_waves four_bosses local_tuning audio")
	for child in game.get_children():
		if child is AudioStreamPlayer:
			child.stop()
	game.queue_free()
	await create_timer(0.25).timeout
	await process_frame
	await process_frame
	quit(0)
